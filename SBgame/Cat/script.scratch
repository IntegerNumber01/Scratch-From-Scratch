define sizer(w):
    x = x+1
    change_size(w)

when_flag_clicked:
    go_to(0, 0)
    x = 100
    y = 100
    forever():
        go_to(EVERYBODY_X, y)

        # now we can handle key pressing using comments!
        if (key_pressed(w)): # if w is pressed
            y = y +1
        if (key_pressed(s)): # if s is pressed
            y = y - 1
        if (key_pressed(a)):
            EVERYBODY_X = EVERYBODY_X - 1
        if (key_pressed(d)):
            EVERYBODY_X = EVERYBODY_X + 1
