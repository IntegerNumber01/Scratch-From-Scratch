when_flag_clicked:
    go_to(120, 90)
    set_size(40)
    show_variable(Score)
    create_clone()
    create_clone()
    create_clone()
    hide()

when_i_start_as_clone:
    go_to_random_position()
    mole_x = x_position
    mole_y = y_position
    mole_size = 40
    was_down = 0
    forever():
        if(mouse_down):
            if(was_down == 0):
                was_down = 1
                if(touching(mouse_pointer)):
                    Score = Score + 1
                    go_to_random_position()
                    mole_x = x_position
                    mole_y = y_position
                else:
                    Score = Score - 1
        else:
            was_down = 0