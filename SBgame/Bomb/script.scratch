when_flag_clicked:
    go_to(140, 100)
    set_size(10)
    show_variable(Score)
    create_clone()
    create_clone()
    hide()

when_i_start_as_clone:
    go_to_random_position()
    was_down = 0
    forever():
        if(mouse_down):
            if(was_down == 0):
                was_down = 1
                if(touching(mouse_pointer)):
                    Score = Score - 5
                    say_for_time(BOOM, 1)
                    go_to_random_position()
        else:
            was_down = 0