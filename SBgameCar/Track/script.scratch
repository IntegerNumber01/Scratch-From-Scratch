when_flag_clicked:
    scroll_x = -458
    scroll_y = -353
    x_vel = 0
    y_vel = 0
    on_off = 0
    point_in_direction(90)
    set_x(scroll_x)
    set_y(scroll_y)
    forever():
        go_to(scroll_x, scroll_y)
        if(on_off == 0):
            if(mouse_down):
                if(not abs(x_vel) > 9 and abs(y_vel) > 9 and not abs(x_vel) + abs(y_vel) > 14):
                    x_vel = x_vel + sin(direction) * -2 * 0.6 * 0.8
                    y_vel = y_vel + cos(direction) * -2 * 0.6 * 0.8
                else:
                    if(not abs(x_vel) > 4.5 and abs(y_vel) > 4.5 and not abs(x_vel) + abs(y_vel) > 9):
                        x_vel = x_vel + sin(direction) * -1 * 0.5
                        y_vel = y_vel + cos(direction) * -1 * 0.5
        scroll_x = scroll_x + x_vel
        x_vel = x_vel * 0.92
        scroll_y = scroll_y + y_vel
        y_vel = y_vel * 0.92
